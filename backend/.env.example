# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://127.0.0.1:5173

# Authentication
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
RESET_TOKEN_TTL_MINUTES=60

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=brightloop_subscriptions
TEST_DB_NAME=brightloop_subscriptions_test
DB_CONNECTION_LIMIT=10

# Email (leave SMTP_HOST empty to log emails locally)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Brightloop Software <no-reply@brightloop.test>

# Billing scheduler
BILLING_CRON_ENABLED=true
BILLING_CRON=0 2 * * *

# Locale
CURRENCY=INR
